PORT=8080
ASPNETCORE_ENVIRONMENT=Development
Mongo__DatabaseName=epr

# RA-311 MGT-F1 — must match OperatorBackendApi__SharedSecret in
# management-be.env. CaseManagementAuthenticationHandler verifies
# management-be's outbound HMAC signature against this value (OBE-F1).
# Kept non-blank on both sides deliberately: the handler fails open in
# Development when this is blank, and this stack exercises the real
# signature check rather than that dev-only bypass.
CaseManagementAuth__SharedSecret=e2e-case-management-shared-secret
