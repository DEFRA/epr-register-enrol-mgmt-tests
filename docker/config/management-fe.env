NODE_ENV=production
ENVIRONMENT=local
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_PASSWORD=E2eTestSessionCookiePasswordNotASecret
AUTH_STUB_ENABLED=true
REDIS_USERNAME=default
REDIS_PASSWORD=E2eTestRedisPassword
REDIS_TLS=false
BACKEND_API_URL=http://epr-register-enrol-management-be:8085
LOG_FORMAT=ecs
# RA-603: an overseas reprocessing site can carry several interim sites.
# Off by default in management-fe so the page is unchanged in environments that
# have not taken the operator journey yet; on here so the RA-603 spec can see
# more than the first one.
MULTIPLE_INTERIM_SITES_ENABLED=true
