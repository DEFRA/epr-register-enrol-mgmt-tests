NODE_ENV=production
# As on CDP test. Anything other than `local` makes management-fe insist on
# its deployed settings: a backend signing secret and a real callback URL.
ENVIRONMENT=test
AUTH_CALLBACK_BASE_URL=http://epr-register-enrol-management-fe:3000
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_PASSWORD=E2eTestSessionCookiePasswordNotASecret
AUTH_STUB_ENABLED=true
REDIS_USERNAME=default
REDIS_PASSWORD=E2eTestRedisPassword
REDIS_TLS=false
BACKEND_API_URL=http://epr-register-enrol-management-be:8085
# Must match AUTH_SHARED_SECRET__MANAGEMENT_FE in management-be.env.
BACKEND_API_SHARED_SECRET=E2eComposeManagementFeToManagementBe
LOG_FORMAT=ecs
# Placeholder id: shows the cookie banner, reports nowhere.
ANALYTICS_ENABLED=true
ANALYTICS_GTM_CONTAINER_ID=GTM-LOCAL0000
