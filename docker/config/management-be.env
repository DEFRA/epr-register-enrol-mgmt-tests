ASPNETCORE_URLS=http://+:8085
ASPNETCORE_ENVIRONMENT=Development
Mongo__DatabaseName=epr-register-case-management
WorkItems__SeedOnStartup=true

# epr-p86e: the decision is atomic and OJ-gated — management-be pushes the
# status change to the operator-journey backend and only completes the
# transition once that push is acknowledged. The real OJ backend
# (epr-register-enrol-backend) is not in this stack, so the push is pointed at
# the lightweight `operator-backend-stub` service, which answers 200 by default
# (and can be armed to return 500 for the failure-path spec). Without this the
# decision can never succeed here and every decision strands the item.
#
# `OperatorBackendApiConfigValidator` requires Url AND a non-empty shared secret
# whenever Enabled is true; the stub verifies neither (the push adapter only
# checks the response STATUS code, never a response signature), so the secret is
# an arbitrary non-empty placeholder. The secret lives in the flat
# OPERATOR_BACKEND_SHARED_SECRET env var per CDP's secrets naming convention,
# NOT under the nested OperatorBackendApi__* keys. ClientId keeps its default.
OperatorBackendApi__Enabled=true
OperatorBackendApi__Url=http://operator-backend-stub:8080
OPERATOR_BACKEND_SHARED_SECRET=E2eTestOperatorSharedSecret

# RA-227: give England a routable-looking but non-existent regulator mailbox so
# the notification-sent path is exercisable here. appsettings.Development.json
# blanks every nation precisely so no environment defaults to the live
# Environment Agency inbox; the stack opts back in with a fake address instead.
# Scotland/Wales/NI are deliberately left blank to exercise the skip path.
Notify__RegulatorMailboxes__England=regulator-england@example.test
