# epr-register-enrol-management-be, configured as on CDP test.
#
# ASPNETCORE_ENVIRONMENT is deliberately unset, so the service runs as
# Production, as it does on CDP: no demo seed data (TestOrganisations__Enabled,
# set in compose.yml, seeds only the two `e2e-` fixtures), and no header-trust
# fallback. Every caller must sign its requests with its own secret below.
ASPNETCORE_URLS=http://+:8085
ENVIRONMENT=test
# CDP's outbound Squid proxy; Production refuses to start without one.
HTTP_PROXY=http://external-services-stub:3128
HTTPS_PROXY=http://external-services-stub:3128
Mongo__DatabaseName=epr-register-case-management

# Inbound callers (v3 HMAC), one secret each, as on CDP test. Each must match
# the caller's own config: management-fe.env, operator-backend.env, and the
# MANAGEMENT_BE_SHARED_SECRET wdio.github.conf.js gives the test runner. The
# mgmt-tests caller is registered only when TestOrganisations__Enabled is true
# (set in compose.yml).
AUTH_SHARED_SECRET__MANAGEMENT_FE=E2eComposeManagementFeToManagementBe
AUTH_SHARED_SECRET__BACKEND=E2eComposeOperatorBackendToManagementBe
AUTH_SHARED_SECRET__MGMT_TESTS=E2eComposeMgmtTestsToManagementBe

# Decisions are pushed to the operator journey backend, which must
# acknowledge them. Must match AUTH_SHARED_SECRET__MANAGEMENT_BE in
# operator-backend.env.
OperatorBackendApi__Enabled=true
OperatorBackendApi__Url=http://epr-register-enrol-backend:8080
OPERATOR_BACKEND_SHARED_SECRET=E2eComposeManagementBeToOperatorBackend

# ReEx through the real HTTP client, against the stub that answers 404 for
# every organisation, as real ReEx does for this suite's organisations.
ReExApi__BaseUrl=http://external-services-stub:8081
REEX_API_BASIC_AUTH_USERNAME=e2e-compose-reex
REEX_API_BASIC_AUTH_PASSWORD=E2eComposeReExPassword

OPERATOR_SERVICE_BASE_URL=http://epr-register-enrol-frontend:3000
CASE_MANAGEMENT_BASE_URL=http://epr-register-enrol-management-fe:3000

# GOV.UK Notify as on CDP test, except that there is no NOTIFY_API_KEY, so
# management-be uses its no-op Notify client: it writes the same
# notification audit entries the specs assert, and sends nothing.
Notify__Enabled=true
NOTIFY_SENDEMAILS=true
Notify__TriggersEnabled__SubmissionConfirmation=true
Notify__TriggersEnabled__DulyMade=true
Notify__TriggersEnabled__Queried=true
Notify__TriggersEnabled__Decision=true
Notify__TriggersEnabled__Withdrawn=true
# The four regulator triggers and the Scotland mailbox are set in compose.yml,
# because they differ between the baseline and the RA-000 config. Every
# mailbox is GOV.UK Notify's simulated address and none falls back to
# appsettings.json, whose defaults are real regulator inboxes.
Notify__RegulatorMailboxes__England=simulate-delivered@notifications.service.gov.uk
Notify__RegulatorMailboxes__Wales=simulate-delivered@notifications.service.gov.uk
Notify__RegulatorMailboxes__NorthernIreland=simulate-delivered@notifications.service.gov.uk
