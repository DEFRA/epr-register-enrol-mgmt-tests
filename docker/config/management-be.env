ASPNETCORE_URLS=http://+:8085
ASPNETCORE_ENVIRONMENT=Development
Mongo__DatabaseName=epr-register-case-management
WorkItems__SeedOnStartup=true

# RA-227: give England a routable-looking but non-existent regulator mailbox so
# the notification-sent path is exercisable here. appsettings.Development.json
# blanks every nation precisely so no environment defaults to the live
# Environment Agency inbox; the stack opts back in with a fake address instead.
# Scotland/Wales/NI are deliberately left blank to exercise the skip path.
Notify__RegulatorMailboxes__England=regulator-england@example.test

# RA-311 MGT-F1 — the real HttpOperatorBackendPushAdapter, pointed at this
# stack's epr-register-enrol-backend container. SharedSecret must match
# CaseManagementAuth__SharedSecret in operator-be.env (OBE-F1); ClientId is
# left at its default ("epr-register-enrol-management-be"), which already
# matches CaseManagementAuthConfig.ExpectedCognitoClientId's own default on
# the operator-backend side, so nothing needs setting there.
OperatorBackendApi__Enabled=true
OperatorBackendApi__Url=http://epr-register-enrol-backend:8080
OperatorBackendApi__SharedSecret=e2e-case-management-shared-secret
