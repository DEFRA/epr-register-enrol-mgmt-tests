# epr-register-enrol-backend (the operator journey backend), configured as on
# CDP test. ASPNETCORE_ENVIRONMENT is deliberately unset, so it runs as
# Production: real ReEx client, real case-management client, and every
# inbound route authenticated.
ENVIRONMENT=test
# CDP's outbound Squid proxy; Production refuses to start without one.
HTTP_PROXY=http://external-services-stub:3128
HTTPS_PROXY=http://external-services-stub:3128
Mongo__DatabaseName=epr-register-enrol-backend
App__BaseUrl=http://epr-register-enrol-backend:8080

# Submissions, withdrawals and resubmissions are sent to management-be, signed
# as the epr-register-enrol-backend caller. Must match
# AUTH_SHARED_SECRET__BACKEND in management-be.env.
CaseWorking__Url=http://epr-register-enrol-management-be:8085
CaseWorking__UseStub=false
CASE_MANAGEMENT_API_SHARED_SECRET=E2eComposeOperatorBackendToManagementBe

# Inbound: management-be's decision pushes (must match its
# OPERATOR_BACKEND_SHARED_SECRET), the operator frontend's Bearer (no
# operator frontend runs here, but setting it switches the Bearer check on, as
# on CDP), and the mgmt-tests Bearer, accepted only when
# TestOrganisations__Enabled is true (set in compose.yml). The last must match
# the OPERATOR_BACKEND_SHARED_SECRET wdio.github.conf.js gives the test runner.
AUTH_SHARED_SECRET__MANAGEMENT_BE=E2eComposeManagementBeToOperatorBackend
AUTH_SHARED_SECRET__FRONTEND=E2eComposeOperatorFrontendToOperatorBackend
AUTH_SHARED_SECRET__MGMT_TESTS=E2eComposeMgmtTestsToOperatorBackend

# ReEx through the real HTTP client, against the 404-for-everything stub.
ReExApi__BaseUrl=http://external-services-stub:8081
REEX_API_BASIC_AUTH_USERNAME=e2e-compose-reex
REEX_API_BASIC_AUTH_PASSWORD=E2eComposeReExPassword

# Required by the readiness check. No spec uploads a file through the
# operator journey, so nothing ever calls it.
CdpUploader__Url=http://cdp-uploader.invalid
