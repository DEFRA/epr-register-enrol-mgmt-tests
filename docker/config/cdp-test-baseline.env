# CDP test's settings BEFORE the RA-000 cdp-app-config change, for
# reproducing a CDP test run on this stack:
#
#   docker compose --env-file docker/config/cdp-test-baseline.env up --wait
#
# compose.yml's defaults are CDP test after that change.

# The four regulator Notify triggers were off.
REGULATOR_TRIGGERS_ENABLED=false
# Every nation had a regulator mailbox (a real, guest-listed address on CDP;
# GOV.UK Notify's simulated address here, which behaves the same).
SCOTLAND_REGULATOR_MAILBOX=simulate-delivered@notifications.service.gov.uk
# No e2e- test organisations and no mgmt-tests callers.
TEST_ORGANISATIONS_ENABLED=false
# management-fe showed only the first interim site of an overseas site. The
# RA-000 cdp-app-config change turns it on for test.
MULTIPLE_INTERIM_SITES_ENABLED=false
